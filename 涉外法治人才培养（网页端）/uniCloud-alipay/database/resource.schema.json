{
	"bsonType": "object",
	"required": ["type", "title"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"type": {
			"bsonType": "string",
			"enum": ["video", "vocabulary", "reading", "listening"],
			"description": "资源类型：video 视频 / vocabulary 词汇 / reading 文本阅读 / listening 听力训练"
		},
		"lang": {
			"bsonType": "string",
			"enum": ["", "英语", "德语", "法语", "拉丁语", "西班牙语"],
			"description": "词汇语言分类，非词汇资源可留空"
		},
		"title": {
			"bsonType": "string",
			"description": "资源标题"
		},
		"cover": {
			"bsonType": "string",
			"description": "封面图 URL"
		},
		"fileUrl": {
			"bsonType": "string",
			"description": "资源文件地址：视频/PDF/文章链接完整 URL 或文件名"
		},
		"audioUrl": {
			"bsonType": "string",
			"description": "听力音频地址，listening 类型使用"
		},
		"content": {
			"bsonType": "string",
			"description": "阅读正文或听力原文"
		},
		"questions": {
			"bsonType": "array",
			"description": "听力/练习题目",
			"items": {
				"bsonType": "object",
				"properties": {
					"type": {
						"bsonType": "string",
						"enum": ["single", "multi"]
					},
					"stem": {
						"bsonType": "string"
					},
					"options": {
						"bsonType": "array",
						"items": {
							"bsonType": "string"
						}
					},
					"answer": {
						"bsonType": ["string", "array", "number", "bool"]
					}
				}
			}
		},
		"description": {
			"bsonType": "string",
			"description": "资源简介"
		},
		"cat": {
			"bsonType": "string",
			"description": "业务分类，如 国际仲裁 / 跨境投资 / 词汇主题 / 阅读主题 / 听力场景"
		},
		"tagClass": {
			"bsonType": "string",
			"description": "分类徽标样式类"
		},
		"meta": {
			"bsonType": "string",
			"description": "视频时长、词汇音标、阅读/听力难度等扩展文字"
		},
		"diffClass": {
			"bsonType": "string",
			"description": "难度徽标样式类"
		},
		"level": {
			"bsonType": "string",
			"description": "难度/等级，如 初级、中级、高级"
		},
		"tags": {
			"bsonType": "array",
			"items": {
				"bsonType": "string"
			},
			"description": "资源标签"
		},
		"sortOrder": {
			"bsonType": "int",
			"description": "手动排序，数字越小越靠前"
		},
		"date": {
			"bsonType": "string",
			"description": "上传日期"
		},
		"status": {
			"bsonType": "string",
			"enum": ["已上线", "审核中"],
			"description": "状态"
		},
		"statusClass": {
			"bsonType": "string",
			"description": "状态徽标样式类"
		},
		"createDate": {
			"bsonType": "timestamp",
			"description": "创建时间"
		}
	}
}
